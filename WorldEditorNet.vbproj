<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>WorldEditorNet</RootNamespace>
    <StartupObject>WorldEditorNet.WorldEditorNet.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="WorldEditorNet.Tests\**" />
    <EmbeddedResource Remove="WorldEditorNet.Tests\**" />
    <None Remove="WorldEditorNet.Tests\**" />
  </ItemGroup>
</Project>
